# Bulldog CBO — environment variables
# Copy this file to .env.local and fill in the values. Do NOT commit .env.local.

# Supabase project URL (safe to expose to the client; PUBLIC_ prefix).
PUBLIC_SUPABASE_URL=

# Supabase anon/public API key (safe to expose to the client; gated by RLS).
PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Server-only — used by scripts/bootstrap.mjs. NEVER expose to the client.
# -----------------------------------------------------------------------------
# Supabase service_role key. Bypasses RLS and can create auth users, so the
# bootstrap script needs it (the anon key cannot). Keep it secret: do not commit
# it and never reference it from any PUBLIC_ variable or client-side code.
# Find it in: Supabase Dashboard -> Project Settings -> API -> service_role.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides for the first owner account created by scripts/bootstrap.mjs.
# Defaults: owner@bulldogcbo.com / bulldog123 / "Dueño Bulldog".
# OWNER_EMAIL=
# OWNER_PASSWORD=
# OWNER_NAME=
